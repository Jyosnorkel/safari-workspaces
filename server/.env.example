# Keep disabled until a real account/model/key and local pairing are configured.
AI_LIVE_ENABLED=false
META_API_PROVIDER_ID=meta
META_API_MODEL=muse-spark-1.3
META_API_KEY=
# MODEL_API_KEY is accepted as a fallback alias, but never put a key in Git.
AI_REQUESTS_PER_MINUTE=2
AI_REQUESTS_PER_DAY=20
AI_TIMEOUT_MS=30000
AI_MAX_INPUT_BYTES=12000
AI_MAX_INPUT_TOKENS=4096
# Includes reasoning and visible JSON output; request-frequency limits stay unchanged.
AI_MAX_OUTPUT_TOKENS=2048
# Optional: one private, persistent absolute directory shared by all copies of this service.
AI_STATE_DIR=
